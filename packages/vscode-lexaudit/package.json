{
  "name": "vscode-lexaudit",
  "displayName": "lexaudit",
  "description": "Locale vocabulary audit: calques, inventeds, foreign slips. Shells out to the local lexaudit CLI \u2014 no cloud.",
  "version": "0.3.1",
  "publisher": "nareyko",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "lexaudit",
    "calque",
    "localization",
    "i18n",
    "spellcheck",
    "false-friends"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nareyko/lexaudit.git"
  },
  "bugs": {
    "url": "https://github.com/nareyko/lexaudit/issues"
  },
  "homepage": "https://github.com/nareyko/lexaudit/tree/main/packages/vscode-lexaudit",
  "activationEvents": [
    "onCommand:lexaudit.auditWorkspace",
    "onCommand:lexaudit.explainSelection"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lexaudit.auditWorkspace",
        "title": "lexaudit: Audit workspace"
      },
      {
        "command": "lexaudit.explainSelection",
        "title": "lexaudit: Explain selection"
      }
    ],
    "configuration": {
      "title": "lexaudit",
      "properties": {
        "lexaudit.locale": {
          "type": "string",
          "default": "en",
          "description": "Locale passed to lexaudit CLI"
        },
        "lexaudit.cli": {
          "type": "string",
          "default": "lexaudit",
          "description": "CLI binary name or absolute path"
        }
      }
    }
  },
  "scripts": {
    "smoke": "node ./extension.js --smoke",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "icon": "icon.png"
}
